<Page x:Class="ClientManager.App.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Login">
    <Grid Background="#ECF0F1">
        <Border Background="White" CornerRadius="5" Padding="40" 
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Width="380" BorderBrush="#DDD" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="3" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Worthington Capital" FontSize="20" FontWeight="Bold" 
                           Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,5" />
                <TextBlock Text="Client Management System" FontSize="12" Foreground="#7F8C8D" 
                           HorizontalAlignment="Center" Margin="0,0,0,30" />

                <Label Content="Username" Style="{StaticResource FormLabel}" />
                <TextBox x:Name="txtUsername" Style="{StaticResource FormTextBox}" />

                <Label Content="Password" Style="{StaticResource FormLabel}" />
                <PasswordBox x:Name="txtPassword" Padding="6,4" FontSize="13" 
                             Margin="0,2,0,8" BorderBrush="#CCC" />

                <TextBlock x:Name="txtError" Foreground="#E74C3C" FontSize="11" 
                           Margin="0,0,0,10" TextWrapping="Wrap" />

                <Button Content="Sign In" Click="BtnLogin_Click" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch" Margin="0,10,0,0" />
                
                <TextBlock Text="Hint: admin / password123" FontSize="10" Foreground="#BDC3C7" 
                           HorizontalAlignment="Center" Margin="0,15,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
