<Page x:Class="ClientManager.App.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Dashboard" Loaded="DashboardPage_OnLoaded">
    <Grid Background="#ECF0F1" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Dashboard" FontSize="22" FontWeight="Bold" 
                   Foreground="#2C3E50" Margin="0,0,0,20" />

        <!-- Stats cards -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20">
            <!-- Total Clients -->
            <Border Background="White" CornerRadius="4" Padding="20" Margin="0,0,10,10" BorderBrush="#DDD" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Total Clients" FontSize="12" Foreground="#7F8C8D" />
                    <TextBlock x:Name="txtTotalClients" Text="—" FontSize="28" FontWeight="Bold" Foreground="#2C3E50" />
                </StackPanel>
            </Border>

            <!-- Active Clients -->
            <Border Background="White" CornerRadius="4" Padding="20" Margin="5,0,5,10" BorderBrush="#DDD" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Active Clients" FontSize="12" Foreground="#7F8C8D" />
                    <TextBlock x:Name="txtActiveClients" Text="—" FontSize="28" FontWeight="Bold" Foreground="#27AE60" />
                </StackPanel>
            </Border>

            <!-- Prospects -->
            <Border Background="White" CornerRadius="4" Padding="20" Margin="10,0,0,10" BorderBrush="#DDD" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Prospects" FontSize="12" Foreground="#7F8C8D" />
                    <TextBlock x:Name="txtProspects" Text="—" FontSize="28" FontWeight="Bold" Foreground="#F39C12" />
                </StackPanel>
            </Border>

            <!-- Total AUM -->
            <Border Background="White" CornerRadius="4" Padding="20" Margin="0,0,10,10" BorderBrush="#DDD" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Total AUM" FontSize="12" Foreground="#7F8C8D" />
                    <TextBlock x:Name="txtTotalAUM" Text="—" FontSize="28" FontWeight="Bold" Foreground="#2C3E50" />
                </StackPanel>
            </Border>

            <!-- Open Accounts -->
            <Border Background="White" CornerRadius="4" Padding="20" Margin="5,0,5,10" BorderBrush="#DDD" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Open Accounts" FontSize="12" Foreground="#7F8C8D" />
                    <TextBlock x:Name="txtTotalAccounts" Text="—" FontSize="28" FontWeight="Bold" Foreground="#2C3E50" />
                </StackPanel>
            </Border>

            <!-- Recent Transactions -->
            <Border Background="White" CornerRadius="4" Padding="20" Margin="10,0,0,10" BorderBrush="#DDD" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Recent Transactions (30d)" FontSize="12" Foreground="#7F8C8D" />
                    <TextBlock x:Name="txtRecentTxn" Text="—" FontSize="28" FontWeight="Bold" Foreground="#3498DB" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Quick actions -->
        <Border Grid.Row="2" Background="White" CornerRadius="4" Padding="20" BorderBrush="#DDD" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Quick Actions" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,15" />
                <WrapPanel>
                    <Button Content="View All Clients" Style="{StaticResource PrimaryButton}" 
                            Click="BtnViewClients_Click" Margin="0,0,10,0" />
                    <Button Content="Run Reports" Style="{StaticResource PrimaryButton}" 
                            Click="BtnRunReports_Click" Margin="0,0,10,0" />
                    <Button Content="Add New Client" Style="{StaticResource PrimaryButton}" 
                            Click="BtnNewClient_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
