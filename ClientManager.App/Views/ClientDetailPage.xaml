<Page x:Class="ClientManager.App.Views.ClientDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Client Detail" Loaded="ClientDetailPage_OnLoaded">
    <Grid Background="#ECF0F1" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <Button Content="← Back" Click="BtnBack_Click" DockPanel.Dock="Left"
                    Background="Transparent" Foreground="#2C3E50" BorderThickness="0" 
                    Cursor="Hand" FontSize="13" />
            <TextBlock x:Name="txtPageTitle" Text="New Client" FontSize="22" FontWeight="Bold" 
                       Foreground="#2C3E50" Margin="15,0,0,0" VerticalAlignment="Center" />
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Client form -->
                <Border Background="White" CornerRadius="4" Padding="20" 
                        Margin="0,0,0,15" BorderBrush="#DDD" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <Label Content="First Name *" Style="{StaticResource FormLabel}" />
                            <TextBox x:Name="txtFirstName" Style="{StaticResource FormTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <Label Content="Last Name *" Style="{StaticResource FormLabel}" />
                            <TextBox x:Name="txtLastName" Style="{StaticResource FormTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <Label Content="Email" Style="{StaticResource FormLabel}" />
                            <TextBox x:Name="txtEmail" Style="{StaticResource FormTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <Label Content="Phone" Style="{StaticResource FormLabel}" />
                            <TextBox x:Name="txtPhone" Style="{StaticResource FormTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                            <Label Content="Address" Style="{StaticResource FormLabel}" />
                            <TextBox x:Name="txtAddress" Style="{StaticResource FormTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0">
                            <Label Content="Status" Style="{StaticResource FormLabel}" />
                            <ComboBox x:Name="cmbStatus" Margin="0,2,0,8" Padding="6,4" FontSize="13">
                                <ComboBoxItem Content="Active" />
                                <ComboBoxItem Content="Inactive" />
                                <ComboBoxItem Content="Prospect" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="2">
                            <Label Content="Risk Profile" Style="{StaticResource FormLabel}" />
                            <ComboBox x:Name="cmbRisk" Margin="0,2,0,8" Padding="6,4" FontSize="13">
                                <ComboBoxItem Content="Low" />
                                <ComboBoxItem Content="Medium" />
                                <ComboBoxItem Content="High" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                            <Label Content="Notes" Style="{StaticResource FormLabel}" />
                            <TextBox x:Name="txtNotes" Style="{StaticResource FormTextBox}" 
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>

                        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Save Client" Click="BtnSave_Click" 
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" />
                            <Button Content="Delete" Click="BtnDelete_Click" 
                                    Background="#E74C3C" Foreground="White" Padding="15,8" 
                                    FontSize="13" Cursor="Hand" BorderThickness="0"
                                    x:Name="btnDelete" />
                            <TextBlock x:Name="txtError" Foreground="#E74C3C" FontSize="12" 
                                       VerticalAlignment="Center" Margin="15,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Accounts grid -->
                <Border Background="White" CornerRadius="4" Padding="20" 
                        BorderBrush="#DDD" BorderThickness="1" x:Name="accountsPanel">
                    <StackPanel>
                        <TextBlock Text="Accounts" FontSize="14" FontWeight="SemiBold" 
                                   Foreground="#2C3E50" Margin="0,0,0,10" />
                        <DataGrid x:Name="dgAccounts" MaxHeight="250">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Account #" Binding="{Binding AccountNumber}" Width="140" />
                                <DataGridTextColumn Header="Type" Binding="{Binding AccountType}" Width="80" />
                                <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=£{0:N2}}" Width="120" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
                                <DataGridTextColumn Header="Opened" Binding="{Binding DateOpened, StringFormat=dd/MM/yyyy}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
