<Page x:Class="ClientManager.App.Views.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Reports">
    <Grid Background="#ECF0F1" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Client Summary Report" FontSize="22" FontWeight="Bold" 
                   Foreground="#2C3E50" Margin="0,0,0,15" />

        <!-- Filters -->
        <Border Grid.Row="1" Background="White" CornerRadius="4" Padding="15" 
                Margin="0,0,0,10" BorderBrush="#DDD" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Label Content="Status Filter:" VerticalAlignment="Center" FontSize="13" />
                <ComboBox x:Name="cmbStatusFilter" Width="150" Margin="10,0,10,0" 
                          Padding="6,4" FontSize="13" SelectedIndex="0">
                    <ComboBoxItem Content="All" />
                    <ComboBoxItem Content="Active" />
                    <ComboBoxItem Content="Inactive" />
                    <ComboBoxItem Content="Prospect" />
                </ComboBox>
                <Button Content="Run Report" Click="BtnRunReport_Click" 
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Border>

        <!-- Report grid -->
        <Border Grid.Row="2" Background="White" CornerRadius="4" Padding="10" 
                BorderBrush="#DDD" BorderThickness="1">
            <DataGrid x:Name="dgReport">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Client Name" Binding="{Binding ClientName}" Width="180" />
                    <DataGridTextColumn Header="Accounts" Binding="{Binding AccountCount}" Width="80" />
                    <DataGridTextColumn Header="Total Balance" Binding="{Binding TotalBalance, StringFormat=£{0:N2}}" Width="140" />
                    <DataGridTextColumn Header="Transactions" Binding="{Binding TransactionCount}" Width="100" />
                    <DataGridTextColumn Header="Total Deposits" Binding="{Binding TotalDeposits, StringFormat=£{0:N2}}" Width="140" />
                    <DataGridTextColumn Header="Total Withdrawals" Binding="{Binding TotalWithdrawals, StringFormat=£{0:N2}}" Width="140" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Totals bar — calculated in code-behind, legacy style -->
        <Border Grid.Row="3" Background="White" CornerRadius="4" Padding="15" 
                Margin="0,10,0,0" BorderBrush="#DDD" BorderThickness="1">
            <DockPanel>
                <TextBlock x:Name="txtTotalSummary" FontSize="13" FontWeight="SemiBold" 
                           Foreground="#2C3E50" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Page>
