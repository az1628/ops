<Window x:Class="ClientManager.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Worthington Capital - Client Manager" 
        Height="700" Width="1050"
        WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_OnLoaded">
    <Grid>
        <!-- Top bar -->
        <Grid.RowDefinitions>
            <RowDefinition Height="45" />
            <RowDefinition Height="*" />
            <RowDefinition Height="25" />
        </Grid.RowDefinitions>

        <!-- Header bar -->
        <Border Grid.Row="0" Background="#2C3E50">
            <DockPanel Margin="10,0">
                <TextBlock Text="Worthington Capital" Foreground="White" FontSize="16" 
                           FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left" />
                
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="txtCurrentUser" Foreground="#BDC3C7" FontSize="11" 
                               VerticalAlignment="Center" Margin="0,0,15,0" />
                    <Button Content="Logout" Click="BtnLogout_Click" FontSize="11"
                            Background="Transparent" Foreground="#BDC3C7" BorderThickness="0"
                            Cursor="Hand" x:Name="btnLogout" Visibility="Collapsed" />
                </StackPanel>

                <!-- Nav buttons — shown after login -->
                <StackPanel x:Name="navPanel" Orientation="Horizontal" VerticalAlignment="Center" 
                            Margin="30,0,0,0" Visibility="Collapsed">
                    <Button Content="Dashboard" Click="BtnDashboard_Click" Background="Transparent" 
                            Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,15,0" FontSize="12" />
                    <Button Content="Clients" Click="BtnClients_Click" Background="Transparent" 
                            Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,15,0" FontSize="12" />
                    <Button Content="Reports" Click="BtnReports_Click" Background="Transparent" 
                            Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="12" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main content frame -->
        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden" />

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#ECF0F1">
            <DockPanel Margin="10,0">
                <TextBlock x:Name="txtStatus" Text="Ready" FontSize="10" Foreground="#7F8C8D"
                           VerticalAlignment="Center" DockPanel.Dock="Left" />
                <TextBlock Text="v1.0.0" FontSize="10" Foreground="#7F8C8D"
                           VerticalAlignment="Center" DockPanel.Dock="Right" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
